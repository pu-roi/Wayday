# Normalize new text changes; do not renormalize historical files as part of setup.
* text=auto
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.dart text eol=lf
*.py text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
tools/maps/package-notices.txt text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
