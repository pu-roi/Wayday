# Local service credentials. Copy to .env.local and fill in your own keys.
GEOAPIFY_API_KEY=
LOCATIONIQ_API_KEY=
# Google Android SDKs (Places UI Kit and Navigation SDK).
GOOGLE_MAPS_ANDROID_API_KEY=
# Separate restricted key for the private Routes REST qualification pilot.
GOOGLE_ROUTES_API_KEY=

# Gemini interpretation credential: local storage only; not a Flutter build define.
GEMINI_API_KEY=
GEMINI_PROJECT_NUMBER=

# Public Android build identifiers. Use tool/distribution/release.py, not the private search loader.
WAYDAY_GATEWAY_URL=
WAYDAY_FIREBASE_APP_ID=
WAYDAY_FIREBASE_API_KEY=
WAYDAY_FIREBASE_PROJECT_ID=
WAYDAY_RECAPTCHA_SITE_KEY=
# Server-only Routes credential; never compile into Android.
GOOGLE_ROUTES_SERVER_API_KEY=
