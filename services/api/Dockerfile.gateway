FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src
WORKDIR /app
COPY requirements-gateway.lock ./
RUN pip install --no-cache-dir -r requirements-gateway.lock && useradd --uid 10001 --create-home wayday
COPY src/ ./src/
USER 10001
EXPOSE 8080
CMD ["sh", "-c", "exec uvicorn wayday_api.gateway.app:app --host 0.0.0.0 --port ${PORT:-8080} --no-access-log --no-server-header"]
